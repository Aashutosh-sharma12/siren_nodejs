{
  "name": "node-backend-project",
  "version": "0.0.0",
  "scripts": {
    "build": "./node_modules/.bin/ts-node build.ts",
    "deploy:development": "./node_modules/.bin/ts-node build.ts && pm2 startOrRestart ecosystem.config.js --env development",
    "deploy:test": "./node_modules/.bin/ts-node build.ts && pm2 startOrRestart ecosystem.config.js --env test",
    "deploy:production": "./node_modules/.bin/ts-node build.ts && pm2 startOrRestart ecosystem.config.js --env production",
    "lint": "eslint src/**/*.ts src/**/**/*.ts",
    "lint:fix": "eslint src/**/*.ts src/**/**/*.ts --fix",
    "start": "node -r module-alias/register ./dist --env=production",
    "starts": "NODE_ENV=production node -r module-alias/register dist/server.js",
    "start:dev": "NODE_ENV=development nodemon",
    "start:prod": "NODE_ENV=production nodemon",
    "start:test": "NODE_ENV=test nodemon",
    "test": "nodemon --config ./spec/nodemon.json",
    "test:no-reloading": "./node_modules/.bin/ts-node -r tsconfig-paths/register ./spec"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts, html",
    "exec": "./node_modules/.bin/ts-node -r tsconfig-paths/register ./src"
  },
  "_moduleAliases": {
    "@controllers": "dist/controllers",
    "@utils": "dist/utils",
    "@server": "dist/server",
    "@routes": "dist/routes",
    "@models": "dist/models",
    "@validators": "dist/validators",
    "@Custom_message": "dist/Custom_message"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-ses": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "argon2": "^0.44.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "command-line-args": "^6.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-fileupload": "^1.5.2",
    "find": "^0.3.0",
    "firebase-admin": "^13.4.0",
    "fs-extra": "^11.3.1",
    "glob": "^11.0.3",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jasmine": "^5.9.0",
    "jet-logger": "^2.0.1",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.1.0",
    "mammoth": "^1.10.0",
    "mime-types": "^3.0.1",
    "module-alias": "^2.2.3",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "otp-generator": "^4.0.1",
    "randomstring": "^1.3.1",
    "socket.io": "^4.8.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/command-line-args": "^5.2.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/find": "^0.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jasmine": "^5.1.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/otp-generator": "^4.0.2",
    "@types/randomstring": "^1.3.0",
    "@types/word-extractor": "^1.0.6",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
